pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                // Pulls the code from your GitHub repository
                git branch: 'main', url: 'https://github.com/yashmandloiGE/dummy-repo.git'
            }
        }

        stage('Setup Environment') {
            steps {
                // Creates a virtual environment and installs dependencies
                // Note: If your Jenkins server runs on Windows, change 'sh' to 'bat'
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install pytest pytest-playwright playwright
                playwright install chromium
                '''
            }
        }

        stage('Run Tests') {
            steps {
                // Activates the virtual environment and runs all tests
                sh '''
                . venv/bin/activate
                pytest
                '''
            }
        }
    }
    
    post {
        always {
            echo "Pipeline execution complete."
            // You can add JUnit test result publishing here later if needed
        }
    }
}
